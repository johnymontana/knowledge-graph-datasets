# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Wikidata Import Configuration
BATCH_SIZE=1000
LOG_LEVEL=INFO
DATA_DIR=data/

# SPARQL Query Configuration
WIKIDATA_ENDPOINT=https://query.wikidata.org/sparql
REQUEST_DELAY=1.0
MAX_RETRIES=3
TIMEOUT=30

# Query Templates
# Example: Get all humans with occupation scientist (Q901)
EXAMPLE_QUERY_SCIENTISTS=SELECT ?item ?itemLabel ?birthDate ?deathDate WHERE { ?item wdt:P31 wd:Q5 . ?item wdt:P106 wd:Q901 . OPTIONAL { ?item wdt:P569 ?birthDate } . OPTIONAL { ?item wdt:P570 ?deathDate } . SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" . } } LIMIT 1000

# Example: Get all cities in the United States
EXAMPLE_QUERY_CITIES=SELECT ?item ?itemLabel ?population ?coordinates WHERE { ?item wdt:P31/wdt:P279* wd:Q515 . ?item wdt:P17 wd:Q30 . OPTIONAL { ?item wdt:P1082 ?population } . OPTIONAL { ?item wdt:P625 ?coordinates } . SERVICE wikibase:label { bd:serviceParam wikibase:language "[AUTO_LANGUAGE],en" . } } LIMIT 1000