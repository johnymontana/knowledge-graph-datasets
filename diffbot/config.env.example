# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Diffbot API Configuration
DIFFBOT_TOKEN=your_diffbot_token_here
DIFFBOT_API_BASE_URL=https://kg.diffbot.com/kg/v3
DIFFBOT_API_VERSION=v3

# Import Configuration
BATCH_SIZE=1000
LOG_LEVEL=INFO
DATA_DIR=data/

# API Settings
REQUEST_DELAY=1.0
MAX_RETRIES=3
TIMEOUT=30
MAX_CONCURRENT_REQUESTS=5

# Query Configuration
# Entity types to import: Person, Organization, Article, etc.
DEFAULT_ENTITY_TYPES=Person,Organization
MAX_RESULTS_PER_QUERY=10000

# Example queries - uncomment and modify as needed
# EXAMPLE_SEARCH_QUERY=name:"OpenAI" type:Organization
# EXAMPLE_ENTITY_ID=CmcBbDlnYOhOUQCrM3IbR0Q